{
  "name": "fadeline-overlay",
  "productName": "灵光一挂",
  "version": "0.1.2",
  "description": "灵光一挂 · 把灵感挂到一根绳子上，让时间替你淘汰",
  "main": "main.js",
  "author": "ZiO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZiOstudio/FadeLine.git"
  },
  "homepage": "https://github.com/ZiOstudio/FadeLine#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "test": "node dev/test_layout.js && node dev/test_store.js",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.zio.fadeline",
    "productName": "灵光一挂",
    "directories": {
      "output": "../dist",
      "buildResources": "."
    },
    "files": [
      "**/*",
      "!dev/**",
      "!*.log",
      "!*.md",
      "!config.json",
      "!config.json.bak",
      "!_*"
    ],
    "asarUnpack": [
      "**/node_modules/@koromix/**"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "FadeLine-${version}.exe"
    }
  }
}
